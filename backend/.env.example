# Copy to .env for local use. Never commit real values. On Render, set these in the service's environment.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Supabase > Connect > Session pooler (IPv4, port 5432): postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
DB_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... key. SUPABASE_SERVICE_ROLE_KEY (legacy) is accepted instead.
SUPABASE_SECRET_KEY=
# Optional: without a key the application uses the offline rules and templates.
GEMINI_API_KEY=
GEMINI_MODEL=
# Exact origins, comma separated, for example https://changewise.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
